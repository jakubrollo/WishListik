<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WishListik.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WishListik"
    Shell.FlyoutBehavior="Disabled"
    Title="WishListik">
    <TabBar>

        <!-- Friends Tab -->
        <Tab Title="Friends" Icon="settings_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:FriendsPage}" />
        </Tab>

        <!-- Browse Items Tab -->
        <Tab Title="Browse" Icon="settings_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

        <!-- User Tab -->
        <Tab Title="User" Icon="settings_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:UserPage}" />
        </Tab>

    </TabBar>
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
