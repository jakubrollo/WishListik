<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="WishListik.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:WishListik"
       Shell.FlyoutBehavior="Disabled"
       Title="WishListik">

    <TabBar>
        <!-- Friends Tab with Nested Tabs -->
        <ShellContent Title="Friends" Icon="people.svg" Shell.NavBarIsVisible="False">
            <local:AddedFriendsPage />
        </ShellContent>

        <!-- Browse Items Tab -->
        <ShellContent Title="Browse" Icon="search.svg" Shell.NavBarIsVisible="False">
            <local:MainPage />
        </ShellContent>

        <!-- User Tab -->
        <ShellContent Title="User" Icon="accessibility.svg" Shell.NavBarIsVisible="False">
            <local:UserPage />
        </ShellContent>
    </TabBar>
</Shell>
