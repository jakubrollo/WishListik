<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WishListik.UserPage"
             Title="User Page">
    <VerticalStackLayout Padding="20">
        <Label 
            x:Name="UserNameLabel"
            Text=""
            FontSize="24"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            x:Name="EmailLabel"
            Text=""
            FontSize="18"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            x:Name="RegistrationDateLabel"
            Text=""
            FontSize="18"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!-- CollectionView for displaying wishlist items -->
        <CollectionView x:Name="WishlistItemsCollectionView"
                        ItemsSource="{Binding WishlistItems}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" Margin="5">
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Item.Name}" FontSize="18"/>
                            <Label Text="{Binding Item.Description}" FontSize="14"/>
                            <Label Text="{Binding IsTaken, StringFormat='Status: {0}'}" FontSize="14"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
